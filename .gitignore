# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (Postgres on Neon; client is generated into node_modules)
.env*.local
/src/generated/market-iq

# data-pipeline merge snapshots (merge.py --apply backs up scorecard_data.json before writing)
src/data/scorecard_data.json.*.bak
src/data/.backups/


# v0.22 3b — transient backfill scratch (pipeline outputs per quarter)
.trajectory-backfill-tmp/

# brainstorming visual-companion scratch
.superpowers/

# Python bytecode caches (data pipeline)
__pycache__/
*.pyc

# Calibration export from /admin/sizes — carries who-said-what from sales
# conversations, so it stays out of the repo.
scripts/data-pipeline/reported_sizes.csv

# clerk configuration (can include secrets)
/.clerk/
