// Dedicated Market IQ analytical store.
//
// Identity, organizations, product entitlements, and customer-owned watchlists
// remain in the primary Dwellsy IQ database. This schema contains only source
// observations and derived market facts, allowing Market IQ data to be loaded,
// refreshed, and scaled without touching Operator IQ or Portfolio IQ records.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/market-iq"
}

datasource db {
  provider  = "postgresql"
  url       = env("MARKET_IQ_DATABASE_URL")
  directUrl = env("MARKET_IQ_DATABASE_URL_UNPOOLED")
}

model MarketIqDataImport {
  id               String    @id @default(cuid())
  sourceKind       String
  sourceName       String
  sourceFilename   String?
  sourceChecksum   String    @unique
  marketId         String
  availableThrough DateTime?
  recordCount      Int       @default(0)
  status           String    @default("pending")
  metadata         String    @default("{}")
  importedAt       DateTime  @default(now())

  listings          MarketIqListing[]
  trendObservations MarketIqTrendObservation[]

  @@index([marketId, importedAt(sort: Desc)])
}

model MarketIqSourceRefresh {
  id                     String    @id @default(cuid())
  marketId               String
  sourceKind             String    @default("trends")
  triggerKind            String    @default("manual")
  status                 String    @default("awaiting_source")
  requiredManifest       String
  sourceAvailableThrough DateTime?
  receivedGeographies    Int       @default(0)
  requiredGeographies    Int
  recordCount            Int       @default(0)
  error                  String?
  startedBy              String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  items MarketIqSourceRefreshItem[]

  @@index([marketId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
}

model MarketIqSourceRefreshItem {
  id                     String    @id @default(cuid())
  refreshId              String
  geographyType          String
  geographyValue         String
  requiredSegments       String
  status                 String    @default("awaiting_source")
  importId               String?
  sourceAvailableThrough DateTime?
  recordCount            Int       @default(0)
  reportableSegments     Int       @default(0)
  validation             String    @default("{}")
  receivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  refresh MarketIqSourceRefresh @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@unique([refreshId, geographyType, geographyValue])
  @@index([refreshId, status])
  @@index([geographyType, geographyValue, receivedAt(sort: Desc)])
}

model MarketIqTrendObservation {
  id              String   @id @default(cuid())
  importId        String
  marketId        String
  geographyType   String
  geographyValue  String
  month           DateTime
  propertyType    String
  bedrooms        Int
  observations    Int
  askingRent      Float
  yearOverYearPct Float?
  createdAt       DateTime @default(now())

  dataImport MarketIqDataImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, geographyType, geographyValue, month, propertyType, bedrooms])
  @@index([marketId, geographyType, geographyValue, month])
  @@index([marketId, propertyType, bedrooms, month])
}

model MarketIqAlert {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  marketId       String
  sourceImportId String
  geographyType  String
  geographyValue String
  propertyType   String
  bedrooms       Int
  signalType     String
  severity       String
  headline       String
  narrative      String
  observedMonth  DateTime
  createdAt      DateTime @default(now())

  @@index([marketId, geographyType, geographyValue, observedMonth(sort: Desc)])
  @@index([sourceImportId])
}

// Frozen, dated evidence used by report review. These snapshots are built
// from the read-only Dwellsy source and stored in the isolated Market IQ
// database so a user's review click never depends on a live cross-network
// query completing in the same request.
model MarketIqReportSourceSnapshot {
  id                     String   @id @default(cuid())
  marketId               String
  sourceKind             String   @default("dwellsy_trends")
  sourceAvailableThrough DateTime
  generatedAt            DateTime
  snapshot               String
  checksum               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([marketId, checksum])
  @@index([marketId, generatedAt(sort: Desc)])
}

// Compact, brand-neutral market facts for fast workspace navigation. Home and
// Briefing read this row instead of rebuilding a complete analytical report.
model MarketIqMarketSummary {
  id                     String   @id @default(cuid())
  marketId               String   @unique
  sourceKind             String   @default("dwellsy_trends")
  sourceAvailableThrough DateTime
  generatedAt            DateTime
  summary                String
  checksum               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([sourceAvailableThrough(sort: Desc)])
}

model MarketIqListing {
  id             String    @id @default(cuid())
  importId       String
  sourceRecordId String
  marketId       String
  listingStatus  String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  latitude       Float?
  longitude      Float?
  askingRent     Float?
  squareFeet     Float?
  bedrooms       Float?
  bathrooms      Float?
  propertyType   String
  communityName  String?
  ownerName      String?
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  rawData        String    @default("{}")
  createdAt      DateTime  @default(now())

  dataImport MarketIqDataImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, sourceRecordId])
  @@index([marketId, activatedAt])
  @@index([marketId, city, postalCode])
  @@index([marketId, propertyType, bedrooms])
}

model MarketIqListingFeedRun {
  id                     String    @id @default(cuid())
  marketId               String
  operationKey           String?   @unique
  sourceKind             String    @default("dwellsy_production")
  triggerKind            String    @default("manual")
  status                 String    @default("loading")
  sourceAvailableThrough DateTime?
  recordCount            Int       @default(0)
  apartmentCount         Int       @default(0)
  houseCount             Int       @default(0)
  newCount               Int       @default(0)
  relistedCount          Int       @default(0)
  reactivatedCount       Int       @default(0)
  priceChangeCount       Int       @default(0)
  deactivatedCount       Int       @default(0)
  error                  String?
  startedBy              String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  snapshots      MarketIqLiveListingSnapshot[]
  events         MarketIqListingEvent[]
  supplySnapshot MarketIqListingSupplySnapshot?

  @@index([marketId, completedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
}

// One compact observation per market and UTC day. These rows make supply and
// active-listing-age history readable without querying Dwellsy during page
// render or repeatedly scanning the full listing snapshots.
model MarketIqListingSupplySnapshot {
  id                     String   @id @default(cuid())
  marketId               String
  snapshotDate           DateTime @db.Date
  feedRunId              String   @unique
  sourceAvailableThrough DateTime
  activeListings         Int
  apartmentListings      Int
  houseListings          Int
  ageObservedListings    Int
  medianActiveAgeDays    Int?
  activeOver30Days       Int
  activeOver30SharePct   Float?
  activatedLast7Days     Int
  activatedLast30Days    Int
  age0To7Days            Int
  age8To14Days           Int
  age15To30Days          Int
  age31To60Days          Int
  age61PlusDays          Int
  capturedAt             DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  feedRun MarketIqListingFeedRun @relation(fields: [feedRunId], references: [id], onDelete: Cascade)

  @@unique([marketId, snapshotDate])
  @@index([marketId, snapshotDate(sort: Desc)])
}

model MarketIqLiveListingSnapshot {
  id                     String    @id @default(cuid())
  runId                  String
  marketId               String
  sourceListingId        String
  sourcePropertyId       String
  sourceParentPropertyId String?
  sourceCompanyId        String?
  operatorNameSlug       String?
  communityId            String?
  address                String?
  city                   String?
  state                  String?
  postalCode             String?
  latitude               Float?
  longitude              Float?
  askingRent             Float
  squareFeet             Float?
  bedrooms               Float
  bathrooms              Float?
  propertyType           String
  listingCreatedAt       DateTime?
  sourceUpdatedAt        DateTime?
  capturedAt             DateTime  @default(now())

  run MarketIqListingFeedRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceListingId])
  @@index([marketId, propertyType, bedrooms])
  @@index([marketId, city, postalCode])
  @@index([sourceListingId, capturedAt(sort: Desc)])
  @@index([sourcePropertyId, capturedAt(sort: Desc)])
}

model MarketIqListingEvent {
  id               String    @id @default(cuid())
  fingerprint      String    @unique
  runId            String
  marketId         String
  eventType        String
  sourceListingId  String
  sourcePropertyId String
  propertyType     String
  city             String?
  postalCode       String?
  previousRent     Float?
  currentRent      Float?
  sourceOccurredAt DateTime?
  observedAt       DateTime  @default(now())
  metadata         String    @default("{}")

  run MarketIqListingFeedRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([marketId, eventType, observedAt(sort: Desc)])
  @@index([sourceListingId, observedAt(sort: Desc)])
  @@index([sourcePropertyId, observedAt(sort: Desc)])
}
