// Prisma schema for the Dwellsy IQ PM Intel Platform.
// Postgres (Neon) — pooled connection for app queries, direct connection for
// migrations. Both URLs auto-injected by the Vercel ↔ Neon marketplace
// integration. Local dev pulls them via `vercel env pull .env.local`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Market {
  id                                String   @id // e.g., "chattanooga-tn"
  msaCode                           String // e.g., "16860"
  city                              String
  state                             String // 2-letter
  fullName                          String // "Chattanooga, TN-GA MSA"
  operatorCountTotal                Int
  operatorCountEligible             Int
  medianDomT12                      Float
  medianDomLifetime                 Float
  // v0.6.1 5-cell quadrant counts. JSON blob keyed by quadrant string.
  quadrantSummary                   String
  // v0.6.2 7-cell quadrant counts. JSON blob keyed by quadrant7Cell label.
  // Nullable for forward-compat with pre-v0.6.2 seeds.
  quadrant7CellSummary              String?
  // v0.6.3 — Patch 1: active operator count (≥3 listings T12) replaces the
  // legacy total-operator denominator as the surfaced headline figure.
  // activeOperatorCountBySubmarket carries per-submarket counts as a JSON
  // map (string-keyed submarket slug → int active count) for filtered-state
  // headlines. Both nullable for back-compat with pre-v0.6.3 markets.
  activeOperatorCount               Int?
  activeOperatorCountBySubmarket    String?
  // v0.6.3 — Patch 3: market-level rent growth aggregate (median YoY across
  // ranked operators), national benchmark (identical across all markets,
  // embedded per-market for render simplicity), and pre-computed pp delta
  // for the "vs national" benchmark line. All decimals (e.g. 0.0023 = +0.23%).
  marketRentGrowthT12               Float?
  nationalRentGrowthT12             Float?
  marketRentGrowthDeltaVsNationalPp Float?
  // v0.6.3 — Patch 2: eligibility-window UI label correction (T6M → T12).
  // Methodology was always T12 in production; this string is the label
  // surfaced on the headline tile + methodology page §3. Defaults to T12
  // so back-compat reseeds without an explicit value still read correctly.
  eligibilityWindow                 String?  @default("T12")
  // v0.6.4 Patch 2 — count of ranked operators in this market with at
  // least one concession-mentioning T12 listing. Drives the cohort
  // comparison line on the scorecard Layer 5 Concession Activity
  // section. Default 0 keeps the field safe for back-compat with
  // pre-Patch-2 reseeds.
  operatorsWithConcessions          Int      @default(0)
  pms                               PM[]
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
}

model PM {
  slug                   String   @id // e.g., "doorby-property-management-chattanooga-tn"
  name                   String
  marketId               String
  market                 Market   @relation(fields: [marketId], references: [id])
  // v0.6.1 5-cell label, normalized at seed ("Scattered / Independent" etc.).
  // Kept for back-compat with existing route segments and market filters.
  quadrant               String
  // v0.6.2 7-cell canonical label ("SFR Independent", "Large MF/BTR
  // Institutional", "Hybrid", etc.). Nullable for forward-compat.
  quadrant7Cell          String?
  hybrid                 Boolean  @default(false)
  // v0.6.4 Patch 9 (Phase A) — company-type bucket: "pm" (default-shown)
  // or "broker" (hidden from ranked lists by default, scored in its own
  // cohort, still searchable + has a scorecard). Defaults to "pm" so
  // markets seeded before the company-type columns existed behave
  // unchanged until re-exported. Indexed: the market data layer filters
  // on it for every market-page query.
  operatorType           String   @default("pm")
  rankOverall            Int?
  rankOverallTotal       Int?
  rankQuadrant           Int?
  rankQuadrantTotal      Int?
  claimed                Boolean  @default(false)
  scorecardData          String // JSON blob: full structured scorecard
  methodologyVersion     String // e.g. "v0.6.3"
  dataAsOf               DateTime
  // v0.6.3 — Patch 1 support: per-PM T12 listing counts keyed by submarket
  // slug as a JSON map. Backs the submarket-filtered Eligible-with-footprint
  // tile (count of MSA-eligible operators with t12ListingsBySubmarket[slug]
  // > 0) without re-parsing the full scorecardData blob.
  t12ListingsBySubmarket String?
  // v0.6.3 — Patch 2 informational flag. Almost always false: the T6M→T12
  // label correction was a labeling fix, not a cohort change. Tracked so
  // future audits can attribute eligibility deltas to the correct cause.
  newlyEligibleInV063    Boolean? @default(false)
  // v0.6.4 Patch 1 — canonical operator identity. Every PM carries a
  // canonicalOperatorId; multi-market operators share the same id across
  // markets (e.g. invitation-homes across 4 markets). Single-market
  // operators get an id equal to their PM slug. canonicalOperatorName
  // is the display form (e.g. "Invitation Homes"). The canonicalOperatorId
  // is the foreign key into the CanonicalOperator table for multi-market
  // entities; single-market ids have no matching row.
  canonicalOperatorId    String?
  canonicalOperatorName  String?
  // v0.24 — Dwellsy company-page id: the effective grouping id
  // (parent_company_id if parented, else child_company_id). Deep-links each
  // operator to dwellsy.com/company/<id>; the admin merge tool uses it to
  // confirm merges from source. Null only for the rare name-fallback
  // operators on old-schema CSVs. Not indexed (admin-only read path).
  companyId              String?
  // v0.6.4 Patch 2 — concession detection results from the regex
  // classifier run against listing descriptions over the T12 window.
  // concessionRate is null when the operator wasn't found in the CSV
  // input (no T12 description data), 0 when found but no concession
  // language detected, otherwise count / t12ListingsCount as a
  // decimal. concessionPatterns is a JSON array of pattern identifiers
  // (move_in_special, free_month_lease, etc.) ordered by frequency.
  // concessionSampleText carries one representative listing excerpt
  // for display. Always non-ranking — context only on Layer 5.
  concessionListingCount Int      @default(0)
  concessionRate         Float?
  concessionPatterns     String   @default("[]") // JSON array
  concessionSampleText   String?
  // v0.6.4 Patch 2 follow-up — up to 3 distinct concession sample
  // excerpts. Authoritative for the Layer 5 UI; concessionSampleText
  // stays for back-compat with downstream readers that may not have
  // migrated yet. Stored as JSON array string, same convention as
  // concessionPatterns + the other JSON-as-String columns in the schema.
  concessionSamples      String   @default("[]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // v0.6.4 Patch 9 — market pages query PMs by market then split by
  // company-type bucket; this composite index serves that access path.
  @@index([marketId, operatorType])
}

// v0.6.4 Patch 1 — cross-market canonical operator entity.
// One row per canonical entity with marketCount ≥ 2; single-market PMs
// don't have a row here (their canonicalOperatorId equals their PM slug
// and points nowhere in this table). marketIds, pmSlugs, and
// aggregateStats are JSON-encoded strings (kept as text columns to match
// the existing JSON-as-String pattern used for scorecardData on PM and
// the quadrant summaries on Market — application code parses on read).
model CanonicalOperator {
  id                   String                          @id @default(cuid())
  canonicalSlug        String                          @unique
  canonicalName        String
  marketIds            String // JSON array of market ids
  pmSlugs              String // JSON array of PM slugs
  marketCount          Int
  aggregateStats       String // JSON blob with sum stats
  createdAt            DateTime                        @default(now())
  portfolioAssignments PortfolioIqOperatorAssignment[]
}

model Lead {
  id                String   @id @default(cuid())
  marketId          String?
  propertyType      String // "single-family", "small-mf", "multifamily", "condo"
  unitCount         Int?
  preferredQuadrant String?
  ownerName         String
  ownerEmail        String
  ownerPhone        String?
  notes             String?
  matchedPms        String // JSON array of pm slugs
  source            String? // referring page
  createdAt         DateTime @default(now())
}

model Claim {
  id             String   @id @default(cuid())
  pmSlug         String
  contactEmail   String
  contactName    String
  domainVerified Boolean  @default(false)
  status         String   @default("pending") // pending | verified | rejected
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Auto-generated weekly market brief cache. One row per (marketSlug,
// methodologyVersion, dataAsOf) tuple — cache invalidates implicitly
// when either version changes because no row will exist for the new
// tuple. headlineRead, shareMovement, operatorLandscape, notableSignals
// are the four prose sections Claude produces. inputDigest is a SHA-256
// of the structured MarketBriefData input the prose was generated from,
// kept for debugging (e.g., "did the seed change but version didn't?").
model MarketBrief {
  id                 String   @id @default(cuid())
  marketSlug         String
  methodologyVersion String
  dataAsOf           DateTime
  // Briefs V2 — "since last period" change lede, rendered first. Default ""
  // for rows written before the column; the PROMPT_VERSION bump invalidates
  // those on next visit so they regenerate with the section populated.
  sinceLastPeriod    String   @default("")
  headlineRead       String
  shareMovement      String
  operatorLandscape  String
  notableSignals     String
  inputDigest        String
  generatedAt        DateTime @default(now())

  // Composite uniqueness: at most one brief per cache key.
  @@unique([marketSlug, methodologyVersion, dataAsOf])
  @@index([marketSlug])
}

// Watch List. Acquirer-defined structured search criteria that get
// applied across the operator universe to produce a ranked target
// list. Three layers of criteria:
//   requiredCriteria  — deal-breakers. PM excluded entirely on any miss.
//   preferredCriteria — weighted preferences. Drive the 0-100 fit score.
//   excludedCriteria  — negative filters. PM excluded if any matches.
//
// Criteria are stored as JSON-encoded String columns (consistent with
// the existing JSON-as-String pattern used across this schema —
// scorecardData, marketIds, pmSlugs, aggregateStats, etc.).
// Application code parses on read; schema is provider-portable.
//
// Originally shipped in v0.8 under the model name BuyBox; renamed
// to WatchList in v0.15 via the 20260522_rename_buy_box_to_watch_list
// migration. ownerId is owned by the authenticated Clerk user as of
// PR #50.
model WatchList {
  id                String   @id @default(cuid())
  name              String
  description       String?
  ownerId           String
  isShared          Boolean  @default(false)
  // JSON-encoded arrays. See src/lib/watch-list/fields.ts for the
  // FilterCriterion + WeightedCriterion shapes.
  requiredCriteria  String   @default("[]")
  preferredCriteria String   @default("[]")
  excludedCriteria  String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // v0.18 (PR #65) — Multi-tenancy via Clerk Organizations.
  // organizationId is the FK that drives authorization in Phase 1+;
  // ownerId stays populated for back-compat and forensics but is no
  // longer consulted for authz checks. Nullable in Phase 1 to allow
  // the additive schema → backfill script → enforce-NOT-NULL deploy
  // sequence; a follow-up migration in the next PR enforces NOT NULL
  // once the script has run against prod data.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // v0.16 — per-user view ledger. Drives the change-detection
  // banner; one row written per signed-in page-view. Cascade-delete
  // so removing a watch list cleans up its view history.
  views WatchListView[]

  // Smart / pinned / hybrid is DERIVED from content (criteria-presence +
  // pin count) via src/lib/watch-list/kind.ts. The v0.26 `kind` column
  // was dropped (20260718000000_drop_watch_list_kind) once nothing read
  // it for behavior or display.
  members WatchListMember[]

  @@index([ownerId])
  // Hot query: list all watch lists in an org, most-recently-updated
  // first. Mirrors the existing ownerId-indexed pattern.
  @@index([organizationId, updatedAt(sort: Desc)])
}

// v0.16 — Operator change-detection feedback loop.
//
// Snapshot per (operator × dataAsOf). Written at seed time, one row
// per PM. snapshotDate carries the methodology's dataAsOf (NOT the
// deploy date) so the cadence matches the underlying data refresh
// (currently monthly: April-data lands in May, May-data lands in
// June, etc.). The @@unique([pmSlug, snapshotDate]) constraint
// makes the capture idempotent — re-deploys against the same
// scorecard JSON are no-ops via createMany({ skipDuplicates: true }).
//
// Diff comparisons read two snapshots per operator:
//   - latest        — the current state at view time
//   - prior         — the snapshot closest to (but not after) the
//                     user's last WatchListView.viewedAt
// See src/lib/watch-list/change-detection.ts for the diff logic.
//
// JSON columns follow the schema-wide JSON-as-String convention. App
// code parses on read; Postgres treats them as text.
model OperatorSnapshot {
  id                 String   @id @default(cuid())
  pmSlug             String
  snapshotDate       DateTime
  methodologyVersion String

  // Per-metric star roll-up. JSON object keyed by metric name,
  // values 'gold' | 'silver' | null. Five metrics today (leaseUp,
  // tenancy, rentPerformance, marketingDiscipline,
  // inventoryTransparency); inventoryTransparency is null for
  // SFR / Hybrid operators.
  starsPerMetric  String
  // Denormalised star totals so the banner count query doesn't have
  // to parse starsPerMetric for every operator in a watch list.
  starGoldCount   Int
  starSilverCount Int

  estimatedPortfolioPoint Int?
  // Confidence tier from the v0.7 size-banded estimator
  // ('Low' | 'Medium' | 'High') OR a non-estimated status string
  // ('insufficient_data' | 'insufficient_history' | 'no_listings').
  // Banding change is the trigger condition independent of point
  // movement, so we store the tier directly rather than re-deriving.
  estimatedPortfolioBand  String?

  // JSON array of MSA slugs the canonical operator has at least
  // one PM in at this snapshot date. For single-market operators
  // this is a 1-element array; for cross-market entities (e.g.
  // Invitation Homes across 4 markets) it's the full footprint.
  // Replicated across every PM row sharing the same
  // canonicalOperatorId so the diff can compute set delta from
  // any single PM snapshot.
  topMSAs       String
  // JSON array of submarket slugs where this PM's
  // t12ListingsBySubmarket > 0. Active-submarket footprint.
  topSubmarkets String

  concessionRate       Float?
  isEligibleForRanking Boolean
  // Operator's T12 listing count at this snapshot (coverage.t12Listings).
  // Nullable: recon rows written before v0.25 lack it until the backfill
  // re-run populates them. Feeds the Momentum "Listing share" sparkline —
  // share per date = this ÷ the market's summed t12ListingsCount that date.
  t12ListingsCount     Int?
  /// v0.8 dormant tier (phase 3). "active" | "dormant" at this snapshot, and
  /// the plain YYYY-MM-DD of the operator's last observed listing. Stored so
  /// the monthly digest can tell that an operator WENT quiet — a transition is
  /// only visible by comparing two snapshots, and a watch-listed operator
  /// going quiet used to produce silence, which is the worst possible outcome
  /// for a monitoring product.
  ///
  /// Nullable: rows written before this existed carry null, and the diff
  /// treats an unknown prior status as "no transition to report" rather than
  /// inventing one on the first run after deploy.
  operatorStatus       String?
  lastListingDate      String?
  // 7-cell classification (quadrant7Cell) at this snapshot. Nullable: rows
  // written before this column lack it. Lets the market brief's "since last
  // period" change block detect cohort moves (e.g. Hybrid → Small MF/BTR)
  // from two consecutive snapshots that both carry it.
  quadrant7Cell        String?
  createdAt            DateTime @default(now())

  // One snapshot per operator per data-cutoff date.
  @@unique([pmSlug, snapshotDate])
  // Latest-snapshot + closest-to-X lookups are the two hot queries.
  // DESC on snapshotDate makes "find the most recent at-or-before X"
  // a single index range scan.
  @@index([pmSlug, snapshotDate(sort: Desc)])
}

// Per-user × per-WatchList × view ledger. Written every time a
// signed-in user opens a watch list's results page. Drives the
// "since your last visit" banner — the diff compares each operator's
// latest snapshot against the snapshot closest to (but not after)
// the user's *previous* viewedAt. The current view's row gets
// written AFTER the diff is computed so the banner reflects what
// changed since last time, not since this load.
//
// v0.18 — DELIBERATELY remains per-user (not per-org). Two analysts
// in the same Organization viewing the same WatchList should have
// independent change-detection timelines, so each gets fresh signal
// on their next visit. Authorization is enforced via the parent
// WatchList's organizationId — view rows can only be read/written
// for watch lists in the caller's active org. See
// src/lib/watch-list/changes.ts for the authz wiring.
model WatchListView {
  id          String   @id @default(cuid())
  userId      String
  watchListId String
  viewedAt    DateTime @default(now())

  watchList WatchList @relation(fields: [watchListId], references: [id], onDelete: Cascade)

  // (userId, watchListId, viewedAt DESC) covers "find the prior
  // viewedAt for this user/watch-list pair" — the only hot query.
  @@index([userId, watchListId, viewedAt(sort: Desc)])
}

// v0.26 — Manual pins for a watch list (the "pick list" side of the
// derived pinned/smart/hybrid model). One row per
// (watchList, operator) pin. Cascade-delete so removing a watch list
// cleans up its members.
model WatchListMember {
  id            String   @id @default(cuid())
  watchListId   String
  // Company-level pin. Value == canonicalOperatorId, or the PM slug for
  // single-market operators (the groupByCanonical fallback key).
  memberKey     String
  addedByUserId String
  createdAt     DateTime @default(now())

  watchList WatchList @relation(fields: [watchListId], references: [id], onDelete: Cascade)

  @@unique([watchListId, memberKey])
  @@index([watchListId])
}

model DigestPreference {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  unsubscribed             Boolean   @default(false)
  cadence                  String    @default("monthly")
  lastNotifiedSnapshotDate DateTime?
  lastDigestAt             DateTime?
  updatedAt                DateTime  @updatedAt
}

// Briefs V2 Phase 3 — per-user prefs for the scheduled MARKET-BRIEF email.
// Deliberately separate from DigestPreference (the watch-list digest): the two
// emails have different audiences and cadences, and sharing one row would
// conflate unsubscribes and the "already notified for this snapshot" guard.
model BriefDigestPreference {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  unsubscribed             Boolean   @default(false)
  cadence                  String    @default("monthly")
  lastNotifiedSnapshotDate DateTime?
  lastDigestAt             DateTime?
  updatedAt                DateTime  @updatedAt
}

model WatchListDigestRun {
  id             String                @id @default(cuid())
  snapshotDate   DateTime
  status         String                @default("running")
  recipientCount Int                   @default(0)
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  sends          WatchListDigestSend[]

  @@index([snapshotDate])
}

model WatchListDigestSend {
  id     String             @id @default(cuid())
  runId  String
  userId String
  email  String
  status String
  sentAt DateTime           @default(now())
  run    WatchListDigestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, userId])
}

// v0.18 (PR #65) — Multi-tenancy Phase 1: Clerk Organizations.
//
// Mirror table for Clerk's Organization resource. We don't store
// user identity here — that stays in Clerk — but we DO mirror orgs
// + memberships so authorization queries don't have to round-trip
// through Clerk's API on every request. The mirror is kept in sync
// by webhook handlers in src/app/api/clerk/webhook/route.ts
// (organization.created/updated/deleted, organizationMembership.*).
//
// `personalForUserId` flags this row as the user's auto-provisioned
// personal workspace (one per Clerk user, created during signup).
// The @unique constraint enforces "at most one personal org per
// user" — webhook handlers + signup flow rely on this to be
// idempotent. NULL when the org was manually created (a real team
// workspace in Phase 2+).
//
// `clerkOrgId` is the @unique sync key; webhook upserts are keyed
// on it so re-delivery of the same Clerk event is a no-op.
model Organization {
  id                 String   @id @default(cuid())
  clerkOrgId         String   @unique
  name               String
  slug               String?
  // Set on personal orgs (one per Clerk user, created at signup).
  // Null on team orgs (Phase 2+). The @unique constraint makes
  // "find personal org for user X" a single indexed lookup AND
  // enforces idempotency of the signup-time org provisioning.
  personalForUserId  String?  @unique
  // v0.22 — market entitlements. `allMarkets = true` means the org is
  // entitled to every current AND future market (internal/comp accounts
  // and national-tier clients); the migration backfills it to true for
  // every pre-existing org so current users don't lose access. When
  // false, entitlement is the explicit set in `marketAccess`. A brand-new
  // org defaults to false + zero grants (fail-closed) — access is
  // provisioned per deal from the admin panel. See
  // src/lib/auth/market-entitlements.ts for the resolver.
  allMarkets         Boolean  @default(false)
  // When true, this org is excluded from ALL outbound digest emails (brief +
  // watch-list). For internal / demo / comp accounts (e.g. the Dwellsy IQ org)
  // that shouldn't receive client-facing digests. Default false; toggled from
  // /admin/organizations. Separate from allMarkets, which national CLIENTS also
  // carry, so it can't stand in for "internal".
  excludeFromDigests Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships                      OrganizationMembership[]
  watchLists                       WatchList[]
  pendingWelcomes                  PendingWelcome[]
  marketAccess                     OrganizationMarketAccess[]
  productAccess                    OrganizationProductAccess[]
  marketIqWatchlists               MarketIqWatchlist[]
  brandProfile                     OrganizationBrandProfile?
  marketIqReports                  MarketIqReport[]
  marketIqReportRecipients         MarketIqReportRecipient[]
  marketIqReportSends              MarketIqReportSend[]
  marketIqEmailEvents              MarketIqEmailEvent[]
  marketIqTestDeliveries           MarketIqTestDelivery[]
  marketIqDistributionCampaigns    MarketIqDistributionCampaign[]
  marketIqCampaignRecipients       MarketIqDistributionCampaignRecipient[]
  marketIqEditionDrafts            MarketIqEditionDraft[]
  marketIqEditionRunItems          MarketIqEditionOrchestrationItem[]
  marketIqSubscriptions            MarketIqSubscription[]
  marketIqWorkspacePreference      MarketIqWorkspacePreference?
  marketIqMarketPreferences        MarketIqMarketPreference[]
  marketIqBriefingSnapshots        MarketIqBriefingSnapshot[]
  marketIqBriefingEmailPreferences MarketIqBriefingEmailPreference[]
  marketIqBriefingEmailDeliveries  MarketIqBriefingEmailDelivery[]
  marketIqBriefingEmailRunItems    MarketIqBriefingEmailRunItem[]
  marketIqJourneyEvents            MarketIqJourneyEvent[]
  marketIqSupportState             MarketIqWorkspaceSupportState?
  marketIqSupportEvents            MarketIqWorkspaceSupportEvent[]
  portfolioIqPortfolios            PortfolioIqPortfolio[]
  dwellsyIqInsights                DwellsyIqInsight[]
  portfolioIqOnboardingRequests    PortfolioIqOnboardingRequest[]

  // Hot lookups: "find personal org for user X" (already covered by
  // the @unique on personalForUserId) and "find org by Clerk id"
  // (covered by the @unique on clerkOrgId). No additional indexes
  // needed for Phase 1.
}

// Dwellsy IQ Online product-level entitlement. This sits above the existing
// per-market grants: a viewer must have the product module AND the market.
// Operator IQ does not consult this table yet, so adding it cannot change an
// existing customer's access path. The migration records operator_iq for all
// existing organizations as bookkeeping while Market IQ remains fail-closed.
model OrganizationProductAccess {
  id             String   @id @default(cuid())
  organizationId String
  productKey     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productKey])
  @@index([organizationId])
}

// Commercial access to Market IQ. Stripe checkout and assisted enterprise
// sales converge here, while the analytical Market IQ database remains free of
// customer identity and billing data. A subscription can carry one or more
// markets without changing Operator IQ's shared market grants.
model MarketIqSubscription {
  id                   String    @id @default(cuid())
  organizationId       String
  source               String // stripe | enterprise
  status               String    @default("incomplete") // incomplete | trialing | active | past_due | paused | canceled | unpaid
  planKey              String    @default("single_market_monthly")
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  billingInterval      String    @default("month") // month | year
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  provisionedByUserId  String?
  startedAt            DateTime?
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  markets      MarketIqSubscriptionMarket[]

  @@index([organizationId, status])
  @@index([stripeCustomerId])
}

model MarketIqSubscriptionMarket {
  id             String   @id @default(cuid())
  subscriptionId String
  marketId       String
  createdAt      DateTime @default(now())

  subscription MarketIqSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, marketId])
  @@index([marketId])
}

// Minimal Stripe event ledger for idempotent webhook processing. We retain
// identifiers and processing state, not the full payment payload.
model MarketIqBillingEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  eventType     String
  status        String    @default("processing") // processing | processed | failed
  error         String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

// A deliberately small event ledger for the Market IQ customer journey. It
// records explicit workflow transitions rather than page views or analytical
// behavior. Stable dedupe keys preserve the first time a workspace reaches a
// milestone while retry and failure events remain individually auditable.
model MarketIqJourneyEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  eventKey       String
  milestone      String // access | setup | edition | test | recipient | audience | delivery
  status         String   @default("completed") // started | completed | failed
  sourceRoute    String?
  subjectId      String?
  dedupeKey      String?  @unique
  metadata       String   @default("{}")
  occurredAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, milestone, status])
  @@index([eventKey, occurredAt(sort: Desc)])
}

// Internal customer-success state for one Market IQ workspace. This model is
// intentionally separate from customer-facing report content and from the
// Operator IQ and Portfolio IQ support models.
model MarketIqWorkspaceSupportState {
  id              String    @id @default(cuid())
  organizationId  String    @unique
  status          String    @default("open") // open | monitoring | resolved
  assignedTo      String?
  assignedUserId  String?
  followUpAt      DateTime?
  latestNote      String?
  updatedByUserId String
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       MarketIqWorkspaceSupportEvent[]

  @@index([status, followUpAt])
  @@index([assignedUserId, status])
}

// Append-only audit trail for Market IQ workspace support. Notes and staff
// assignments remain internal and never render in PM or recipient surfaces.
model MarketIqWorkspaceSupportEvent {
  id             String    @id @default(cuid())
  organizationId String
  supportStateId String
  action         String // opened | updated | monitoring | resolved | reopened | note
  fromStatus     String?
  toStatus       String
  assignedTo     String?
  assignedUserId String?
  followUpAt     DateTime?
  note           String?
  actorUserId    String
  createdAt      DateTime  @default(now())

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supportState MarketIqWorkspaceSupportState @relation(fields: [supportStateId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([supportStateId, createdAt(sort: Desc)])
}

// Market IQ resources are deliberately separate from Operator IQ's WatchList
// model. Operator IQ watch lists rank operators against acquisition criteria;
// Market IQ watchlists monitor rental geographies and product segments. Keeping
// the persistence paths separate prevents a Market IQ preview from changing any
// existing customer workflow or query.
model MarketIqWatchlist {
  id              String   @id @default(cuid())
  name            String
  ownerId         String
  organizationId  String
  marketId        String
  geographyType   String   @default("msa") // msa | city | zip
  geographyValues String   @default("[]") // JSON array of labels/codes
  propertyTypes   String   @default("[\"apartment\",\"house\"]")
  bedroomCounts   String   @default("[]") // JSON array; [] means all
  alertsEnabled   Boolean  @default(true)
  alertCadence    String   @default("weekly")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([marketId])
}

// PM-controlled branding for outward-facing Market IQ reports. The PM is the
// buyer and sender; Dwellsy remains a small data-provenance credit inside the
// immutable report snapshot.
model OrganizationBrandProfile {
  id                     String   @id @default(cuid())
  organizationId         String   @unique
  displayName            String
  logoUrl                String?
  primaryColor           String
  accentColor            String
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  websiteUrl             String?
  defaultClientMessage   String?
  defaultProspectMessage String?
  companyProfile         String?
  companyCtaLabel        String?
  companyCtaUrl          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reports      MarketIqReport[]
}

// One immutable, PM-branded Market IQ artifact. `scope` records the selected
// market geographies and segments used to build it; `snapshot` is
// frozen on publication so a sent report cannot drift as source data changes.
model MarketIqReport {
  id             String    @id @default(cuid())
  organizationId String
  marketId       String
  periodLabel    String
  publicToken    String    @unique
  status         String    @default("draft") // draft | published | revoked
  scope          String
  snapshot       String
  subjectAddress String? // drill-down/prospect mode only; never the report primitive
  brandProfileId String
  generatedBy    String
  editionDraftId String?   @unique
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization          Organization                            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandProfile          OrganizationBrandProfile                @relation(fields: [brandProfileId], references: [id], onDelete: Restrict)
  sends                 MarketIqReportSend[]
  testDeliveries        MarketIqTestDelivery[]
  distributionCampaigns MarketIqDistributionCampaign[]
  campaignRecipients    MarketIqDistributionCampaignRecipient[]

  @@index([organizationId, marketId, createdAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
}

// A private, idempotent handoff from an authoritative Trends IQ period. Review
// mode leaves it private. Autopilot may publish it through a separate service.
model MarketIqEditionDraft {
  id                     String    @id @default(cuid())
  organizationId         String
  marketId               String
  periodEnd              String
  status                 String    @default("ready") // ready | reviewing | published | dismissed | superseded
  sourceKind             String
  sourceAvailableThrough String
  scopeFingerprint       String
  snapshot               String
  comparison             String
  materialChangeCount    Int       @default(0)
  generatedBy            String    @default("recurring-edition-engine")
  detectedAt             DateTime  @default(now())
  reviewStartedAt        DateTime?
  reviewStartedByUserId  String?
  reviewedAt             DateTime?
  dismissedAt            DateTime?
  dismissedByUserId      String?
  dismissalReason        String?
  publishedReportId      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, marketId, periodEnd])
  @@index([organizationId, status, detectedAt(sort: Desc)])
  @@index([marketId, periodEnd])
}

// One auditable scheduler pass across commercially eligible Market IQ
// workspaces. It creates drafts and can hand an autopilot draft to the separate
// publication and delivery service when the saved consent requirements pass.
model MarketIqEditionOrchestrationRun {
  id                     String    @id @default(cuid())
  runKey                 String    @unique
  triggerKind            String    @default("scheduled") // scheduled | manual
  status                 String    @default("running") // running | completed | completed_with_errors | failed
  dryRun                 Boolean   @default(false)
  organizationsEvaluated Int       @default(0)
  draftsCreated          Int       @default(0)
  draftsExisting         Int       @default(0)
  unchangedPeriods       Int       @default(0)
  blockedOrganizations   Int       @default(0)
  failedOrganizations    Int       @default(0)
  sourceAvailableThrough String?
  error                  String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  items MarketIqEditionOrchestrationItem[]

  @@index([status, startedAt(sort: Desc)])
  @@index([triggerKind, startedAt(sort: Desc)])
}

model MarketIqEditionOrchestrationItem {
  id             String   @id @default(cuid())
  runId          String
  organizationId String
  marketId       String
  status         String // created | would_create | existing | unchanged | blocked | failed
  periodEnd      String?
  draftId        String?
  detail         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  run          MarketIqEditionOrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([runId, organizationId, marketId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([runId, status])
}

// An immutable, internal weekly briefing snapshot. It freezes only compact,
// aggregated Market IQ findings and source dates. It never publishes a client
// report, creates a distribution campaign, or sends email.
model MarketIqBriefingSnapshot {
  id              String   @id @default(cuid())
  organizationId  String
  weekOf          String
  payloadVersion  Int      @default(1)
  payload         String
  sourcePeriods   String   @default("{}")
  createdByUserId String
  createdAt       DateTime @default(now())

  organization    Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailDeliveries MarketIqBriefingEmailDelivery[]
  emailRunItems   MarketIqBriefingEmailRunItem[]

  @@unique([organizationId, weekOf])
  @@index([organizationId, createdAt(sort: Desc)])
}

// User-level consent for internal Market IQ briefing delivery. The address is
// copied from the signed-in Clerk identity when the user opts in. It is not a
// Client Advisory recipient and cannot be edited to target another person.
model MarketIqBriefingEmailPreference {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  recipientEmail String
  enabled        Boolean   @default(false)
  enabledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   MarketIqBriefingEmailDelivery[]
  runItems     MarketIqBriefingEmailRunItem[]

  @@unique([organizationId, userId])
  @@index([organizationId, enabled])
}

// Idempotent internal delivery record. This is deliberately separate from
// MarketIqReportSend and the Client Advisory recipient/campaign models.
model MarketIqBriefingEmailDelivery {
  id             String    @id @default(cuid())
  organizationId String
  snapshotId     String
  preferenceId   String
  userId         String
  recipientEmail String
  status         String    @default("sending") // sending | sent | failed
  attemptCount   Int       @default(1)
  providerId     String?
  error          String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot     MarketIqBriefingSnapshot        @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  preference   MarketIqBriefingEmailPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, userId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([preferenceId, status])
}

// One auditable pass of the internal briefing scheduler. Phase one is
// deliberately dry-run only. It records eligibility without sending email.
model MarketIqBriefingEmailRun {
  id             String    @id @default(cuid())
  triggerKind    String    @default("scheduled") // scheduled | manual
  dryRun         Boolean   @default(true)
  status         String    @default("running") // running | completed | failed
  candidateCount Int       @default(0)
  eligibleCount  Int       @default(0)
  skippedCount   Int       @default(0)
  error          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items MarketIqBriefingEmailRunItem[]

  @@index([status, startedAt(sort: Desc)])
  @@index([triggerKind, startedAt(sort: Desc)])
}

model MarketIqBriefingEmailRunItem {
  id             String   @id @default(cuid())
  runId          String
  organizationId String
  preferenceId   String
  snapshotId     String?
  userId         String
  recipientEmail String
  status         String // would_send | excluded | no_archive | already_sent | in_progress | retry_requires_click
  detail         String
  createdAt      DateTime @default(now())

  run          MarketIqBriefingEmailRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preference   MarketIqBriefingEmailPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  snapshot     MarketIqBriefingSnapshot?       @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@unique([runId, preferenceId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([runId, status])
}

model MarketIqReportRecipient {
  id                String    @id @default(cuid())
  organizationId    String
  name              String
  companyName       String?
  email             String
  kind              String // client | prospect
  emailStatus       String    @default("active") // active | suppressed
  suppressionReason String?
  suppressedAt      DateTime?
  recurringDeliveryApprovedAt       DateTime?
  recurringDeliveryApprovedByUserId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization       Organization                            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sends              MarketIqReportSend[]
  campaignRecipients MarketIqDistributionCampaignRecipient[]

  @@unique([organizationId, email])
  @@index([organizationId, kind, name])
}

// A staged distribution run for one immutable Market IQ edition. Publishing
// creates a draft campaign, but never sends email. Audience review and final
// confirmation happen on a separate route before the campaign can send.
model MarketIqDistributionCampaign {
  id              String    @id @default(cuid())
  organizationId  String
  reportId        String
  status          String    @default("draft") // draft | ready | sending | complete | partial
  createdByUserId String
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization                            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       MarketIqReport                          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipients   MarketIqDistributionCampaignRecipient[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([reportId])
}

// The unique report and recipient pair is the delivery idempotency boundary.
// Failed rows can be retried in place, while repeated clicks or a second
// campaign cannot send the same edition to the same person twice.
model MarketIqDistributionCampaignRecipient {
  id             String    @id @default(cuid())
  organizationId String
  campaignId     String
  reportId       String
  recipientId    String
  sendId         String?
  status         String    @default("pending") // pending | sending | sent | failed | suppressed | already_sent
  attemptCount   Int       @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     MarketIqDistributionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  report       MarketIqReport               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipient    MarketIqReportRecipient      @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([reportId, recipientId])
  @@index([campaignId, status])
  @@index([organizationId, createdAt(sort: Desc)])
}

// Organization-level Market IQ setup. These values are customer preferences,
// not analytical data, and stay isolated from the Dwellsy trends store.
model MarketIqWorkspacePreference {
  id                       String    @id @default(cuid())
  organizationId           String    @unique
  defaultMarketId          String
  defaultCities            String    @default("[]")
  defaultZipCodes          String    @default("[]")
  defaultSegments          String    @default("[]")
  onboardingCompletedAt    DateTime?
  recurringEditionsEnabled Boolean   @default(false)
  recurringEnabledAt       DateTime?
  recurringEnabledByUserId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([defaultMarketId])
}

// Market-specific Market IQ settings. The workspace preference above remains
// the organization-wide onboarding and default-market record; these rows let
// each entitled market retain its own scope and recurring-edition enrollment.
model MarketIqMarketPreference {
  id                       String    @id @default(cuid())
  organizationId           String
  marketId                 String
  cities                   String    @default("[]")
  zipCodes                 String    @default("[]")
  segments                 String    @default("[]")
  configuredAt             DateTime?
  recurringEditionsEnabled Boolean   @default(false)
  recurringEnabledAt       DateTime?
  recurringEnabledByUserId String?
  deliveryMode             String    @default("review") // review | autopilot
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, marketId])
  @@index([marketId])
  @@index([organizationId, recurringEditionsEnabled])
}

model MarketIqReportSend {
  id                 String    @id @default(cuid())
  organizationId     String
  reportId           String
  recipientId        String
  deliveryStatus     String    @default("not_sent") // not_sent | sent | failed
  deliveryProviderId String?
  deliveryError      String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  lastEmailEventAt   DateTime?
  lastEmailEventType String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       MarketIqReport          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipient    MarketIqReportRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  events       MarketIqEmailEvent[]

  @@index([organizationId, deliveryStatus, createdAt(sort: Desc)])
  @@index([reportId, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([deliveryProviderId])
}

// Append-only SendGrid evidence for Market IQ distribution. Provider event
// IDs are unique so webhook retries cannot inflate edition or recipient
// engagement. This begins prospectively and does not infer past events.
model MarketIqEmailEvent {
  id                 String   @id @default(cuid())
  providerEventId    String   @unique
  organizationId     String
  reportSendId       String
  providerMessageId  String?
  eventType          String
  occurredAt         DateTime
  reason             String?
  responseCode       String?
  engagementStrength String   @default("operational") // operational | directional | explicit
  createdAt          DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportSend   MarketIqReportSend @relation(fields: [reportSendId], references: [id], onDelete: Cascade)

  @@index([organizationId, eventType, occurredAt(sort: Desc)])
  @@index([reportSendId, eventType, occurredAt(sort: Desc)])
  @@index([providerMessageId])
}

// A PM-requested verification email sent only to the signed-in user's Clerk
// address. Test deliveries never enter the client/prospect directory, never
// create a campaign, and never count as a customer distribution.
model MarketIqTestDelivery {
  id                String    @id @default(cuid())
  organizationId    String
  reportId          String
  requestedByUserId String
  recipientEmail    String
  status            String    @default("sending") // sending | accepted | failed
  providerId        String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  report       MarketIqReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([reportId, createdAt(sort: Desc)])
  @@index([requestedByUserId, createdAt(sort: Desc)])
}

// One row per immutable source file. The checksum is the idempotency key, so a
// historical export can be safely retried without duplicating its records.
model MarketIqDataImport {
  id               String    @id @default(cuid())
  sourceKind       String // historical_export | trends | live_listing_feed
  sourceName       String
  sourceFilename   String?
  sourceChecksum   String    @unique
  marketId         String
  availableThrough DateTime?
  recordCount      Int       @default(0)
  status           String    @default("pending")
  metadata         String    @default("{}")
  importedAt       DateTime  @default(now())

  listings          MarketIqListing[]
  trendObservations MarketIqTrendObservation[]

  @@index([marketId, importedAt(sort: Desc)])
}

// One requested source cycle. The application can create and audit this
// manifest even while an upstream MCP is unavailable. Findings refresh only
// after every requested geography has reported complete, fresh coverage, so a
// missing or sparse payload cannot look like a quiet market.
model MarketIqSourceRefresh {
  id                     String    @id @default(cuid())
  marketId               String
  sourceKind             String    @default("trends")
  triggerKind            String    @default("manual") // manual | scheduled | mcp
  status                 String    @default("awaiting_source") // awaiting_source | receiving | complete | complete_with_gaps | blocked
  requiredManifest       String
  sourceAvailableThrough DateTime?
  receivedGeographies    Int       @default(0)
  requiredGeographies    Int
  recordCount            Int       @default(0)
  error                  String?
  startedBy              String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  items MarketIqSourceRefreshItem[]

  @@index([marketId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
}

model MarketIqSourceRefreshItem {
  id                     String    @id @default(cuid())
  refreshId              String
  geographyType          String
  geographyValue         String
  requiredSegments       String
  status                 String    @default("awaiting_source") // awaiting_source | complete | sparse | stale | invalid
  importId               String?
  sourceAvailableThrough DateTime?
  recordCount            Int       @default(0)
  reportableSegments     Int       @default(0)
  validation             String    @default("{}")
  receivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  refresh MarketIqSourceRefresh @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@unique([refreshId, geographyType, geographyValue])
  @@index([refreshId, status])
  @@index([geographyType, geographyValue, receivedAt(sort: Desc)])
}

// Normalized Dwellsy IQ rent-trend point. These observations come from the
// authoritative rent-trends product, never from the historical listing export.
// Geography is explicit so the same model supports MSA, city, and ZIP views.
model MarketIqTrendObservation {
  id              String   @id @default(cuid())
  importId        String
  marketId        String
  geographyType   String // msa | city | zip
  geographyValue  String
  month           DateTime
  propertyType    String // apartment | house
  bedrooms        Int
  observations    Int
  askingRent      Float
  yearOverYearPct Float?
  createdAt       DateTime @default(now())

  dataImport MarketIqDataImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, geographyType, geographyValue, month, propertyType, bedrooms])
  @@index([marketId, geographyType, geographyValue, month])
  @@index([marketId, propertyType, bedrooms, month])
}

// Material changes derived from authoritative trend snapshots. Alerts are
// market-level facts and are filtered against organization watchlists at read
// time, keeping one canonical event instead of duplicating it per customer.
model MarketIqAlert {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  marketId       String
  sourceImportId String
  geographyType  String
  geographyValue String
  propertyType   String
  bedrooms       Int
  signalType     String // yoy_growth | yoy_softening | monthly_move
  severity       String // watch | material
  headline       String
  narrative      String
  observedMonth  DateTime
  createdAt      DateTime @default(now())

  @@index([marketId, geographyType, geographyValue, observedMonth(sort: Desc)])
  @@index([sourceImportId])
}

// Normalized asking-listing observation from an immutable Market IQ import.
// This is not a lease, occupancy, or effective-rent record.
model MarketIqListing {
  id             String    @id @default(cuid())
  importId       String
  sourceRecordId String
  marketId       String
  listingStatus  String?
  address        String?
  city           String?
  state          String?
  postalCode     String?
  latitude       Float?
  longitude      Float?
  askingRent     Float?
  squareFeet     Float?
  bedrooms       Float?
  bathrooms      Float?
  propertyType   String
  communityName  String?
  ownerName      String?
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  rawData        String    @default("{}")
  createdAt      DateTime  @default(now())

  dataImport MarketIqDataImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, sourceRecordId])
  @@index([marketId, activatedAt])
  @@index([marketId, city, postalCode])
  @@index([marketId, propertyType, bedrooms])
}

// Portfolio IQ is the connective owner/asset layer across Market IQ and
// Operator IQ. These records are additive: they do not alter the operator
// scorecards, rankings, or customer access paths used by Operator IQ.
model PortfolioIqPortfolio {
  id             String   @id @default(cuid())
  organizationId String
  marketId       String
  slug           String
  name           String
  ownerLabel     String?
  status         String   @default("activating") // activating | ready | archived
  onboardingMode String   @default("assisted")
  isSynthetic    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets               PortfolioIqAsset[]
  signals              PortfolioIqSignal[]
  digestPreferences    PortfolioIqDigestPreference[]
  unifiedInsights      DwellsyIqInsight[]
  launchBriefing       PortfolioIqLaunchBriefing?
  monitoringSnapshots  PortfolioIqMonitoringSnapshot[]
  monitoringRuns       PortfolioIqMonitoringRun[]
  pmBriefs             PortfolioIqPmBrief[]
  outcomeReviews       PortfolioIqOutcomeReview[]
  ownerWatchItems      PortfolioIqOwnerWatchItem[]
  ownerWatchReviews    PortfolioIqOwnerWatchReview[]
  pilotAcceptance      PortfolioIqPilotAcceptance?
  pilotReviews         PortfolioIqPilotReview[]
  pilotCorrections     PortfolioIqPilotCorrection[]
  findingFeedback      PortfolioIqFindingFeedback[]
  findingCalibrations  PortfolioIqFindingCalibration[]
  calibrationProposals PortfolioIqCalibrationProposal[]
  pilotEngagements     PortfolioIqPilotEngagement[]
  pilotSuccessPlan     PortfolioIqPilotSuccessPlan?
  pilotInterventions   PortfolioIqPilotIntervention[]
  emailEvents          PortfolioIqEmailEvent[]
  pilotValueReviews    PortfolioIqPilotValueReview[]

  @@unique([organizationId, slug])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([marketId])
}

// Staff-owned operating plan for an assisted pilot. The derived lifecycle
// score remains evidence-based; this record adds the human accountability
// needed to move an account through that journey.
model PortfolioIqPilotSuccessPlan {
  id              String    @id @default(cuid())
  portfolioId     String    @unique
  organizationId  String
  staffOwnerName  String?
  successGoal     String?
  nextCheckInAt   DateTime?
  updatedByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([organizationId, nextCheckInAt])
}

// Calls, emails, meetings, decisions, notes, and follow-ups form the internal
// customer-success timeline. These do not alter analytical findings or any
// Operator IQ scorecard data.
model PortfolioIqPilotIntervention {
  id              String    @id @default(cuid())
  portfolioId     String
  organizationId  String
  kind            String // call | email | meeting | decision | note | follow_up
  status          String    @default("open") // open | scheduled | completed | blocked
  title           String
  note            String?
  dueAt           DateTime?
  completedAt     DateTime?
  assignedTo      String?
  createdByUserId String
  sourceEventId   String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueAt])
  @@index([portfolioId, createdAt(sort: Desc)])
}

// Verified SendGrid Event Webhook evidence for Portfolio IQ messages. Raw
// email addresses, full URLs, user agents, and IP addresses are deliberately
// not retained here.
model PortfolioIqEmailEvent {
  id                    String    @id @default(cuid())
  providerEventId       String    @unique
  portfolioId           String
  organizationId        String
  messageKind           String // owner_digest | pm_brief
  messageRecordId       String
  providerMessageId     String?
  eventType             String
  occurredAt            DateTime
  reason                String?
  responseCode          String?
  engagementStrength    String    @default("operational") // operational | directional | explicit
  interventionCreatedAt DateTime?
  createdAt             DateTime  @default(now())

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([portfolioId, occurredAt(sort: Desc)])
  @@index([messageKind, messageRecordId])
}

// A frozen, owner-visible pilot review. The snapshot preserves the evidence
// shown during a conversion or renewal conversation without converting
// asking-market prioritization into claimed realized financial performance.
model PortfolioIqPilotValueReview {
  id             String   @id @default(cuid())
  reviewKey      String   @unique
  portfolioId    String
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  snapshot       String
  finalizedBy    String
  finalizedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([organizationId, finalizedAt(sort: Desc)])
  @@index([portfolioId, periodEnd(sort: Desc)])
}

// Minimal first-party engagement evidence for pilot operations. This records
// workspace visits only, not clickstream behavior or analytical content.
model PortfolioIqPilotEngagement {
  id             String   @id @default(cuid())
  portfolioId    String
  organizationId String
  userId         String
  firstViewedAt  DateTime @default(now())
  lastViewedAt   DateTime @default(now())
  viewCount      Int      @default(1)
  lastRoute      String   @default("/today")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, userId])
  @@index([organizationId, lastViewedAt(sort: Desc)])
  @@index([portfolioId, lastViewedAt(sort: Desc)])
}

// Per-owner reactions improve the attention queue without rewriting the
// analytical finding or changing another user's view of the portfolio.
model PortfolioIqFindingFeedback {
  id                String   @id @default(cuid())
  portfolioId       String
  organizationId    String
  signalId          String
  userId            String
  rating            String // useful | already_known | immaterial | duplicate | stale | wrong_context
  note              String?
  suppressFromQueue Boolean  @default(false)
  reviewedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  signal    PortfolioIqSignal    @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, userId, signalId])
  @@index([organizationId, rating, reviewedAt(sort: Desc)])
  @@index([portfolioId, rating])
  @@index([userId, suppressFromQueue])
}

// The active, administrator-approved ranking adjustment for one finding
// family. Owner feedback can propose a change but can never write this record.
model PortfolioIqFindingCalibration {
  id              String   @id @default(cuid())
  portfolioId     String
  organizationId  String
  scopeKind       String   @default("signal_type")
  scopeValue      String
  scoreAdjustment Int      @default(0)
  revision        Int      @default(1)
  approvedBy      String
  approvedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  portfolio PortfolioIqPortfolio             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  proposals PortfolioIqCalibrationProposal[]

  @@unique([portfolioId, scopeKind, scopeValue])
  @@index([organizationId, updatedAt(sort: Desc)])
}

// Immutable review packets preserve the evidence and previous setting behind
// every proposed, approved, or rejected calibration decision.
model PortfolioIqCalibrationProposal {
  id                      String    @id @default(cuid())
  portfolioId             String
  organizationId          String
  calibrationId           String?
  scopeKind               String    @default("signal_type")
  scopeValue              String
  status                  String    @default("proposed") // proposed | approved | rejected
  priorScoreAdjustment    Int       @default(0)
  proposedScoreAdjustment Int
  sampleSize              Int
  usefulCount             Int
  alreadyKnownCount       Int
  noiseCount              Int
  contextErrorCount       Int
  baselineUsefulRate      Float?
  rationale               String
  proposedBy              String
  proposedAt              DateTime  @default(now())
  reviewedBy              String?
  reviewedAt              DateTime?
  reviewNote              String?
  impactSnapshot          String    @default("{}")
  createdAt               DateTime  @default(now())

  portfolio   PortfolioIqPortfolio           @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  calibration PortfolioIqFindingCalibration? @relation(fields: [calibrationId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, proposedAt(sort: Desc)])
  @@index([portfolioId, scopeKind, scopeValue, proposedAt(sort: Desc)])
}

// The assisted onboarding specialist uses this one-session record to move a
// configured portfolio into owner-approved monitoring. It is separate from
// source evidence and never changes an analytical finding.
model PortfolioIqPilotAcceptance {
  id               String    @id @default(cuid())
  portfolioId      String    @unique
  organizationId   String
  status           String    @default("in_progress") // in_progress | accepted
  sessionStartedAt DateTime  @default(now())
  acceptedAt       DateTime?
  acceptedBy       String?
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, updatedAt(sort: Desc)])
}

// Owner reactions captured during launch. Generic object keys let the same
// workflow review properties, operator assignments, and immutable findings
// without rewriting any of those source records.
model PortfolioIqPilotReview {
  id             String   @id @default(cuid())
  portfolioId    String
  organizationId String
  objectType     String // property | operator | finding
  objectId       String
  response       String // confirmed | useful | investigate | incorrect | acted
  note           String?
  reviewedBy     String
  reviewedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, objectType, objectId])
  @@index([organizationId, reviewedAt(sort: Desc)])
  @@index([portfolioId, objectType])
}

// Every launch-call correction enters an explicit internal queue, including
// portfolio-wide finding corrections that cannot be attached to one asset.
model PortfolioIqPilotCorrection {
  id             String    @id @default(cuid())
  portfolioId    String
  organizationId String
  assetId        String?
  objectType     String
  objectId       String
  issue          String
  status         String    @default("open") // open | in_progress | complete
  assignedLane   String    @default("customer_success")
  createdBy      String
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, objectType, objectId])
  @@index([organizationId, status, updatedAt(sort: Desc)])
  @@index([portfolioId, status])
  @@index([assetId])
}

// Shared owner-watch pins for the unified Dwellsy IQ Online workspace. These
// records connect portfolio objects without changing either Operator IQ's
// acquisition WatchList model or Market IQ's geography watchlists.
model PortfolioIqOwnerWatchItem {
  id             String   @id @default(cuid())
  portfolioId    String
  organizationId String
  objectType     String // property | geography | operator | decision
  objectKey      String
  label          String
  href           String
  pinnedBy       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, objectType, objectKey])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([portfolioId, objectType])
}

// A private read watermark for one person and one monitored owner object.
// Reviewing an item never changes shared evidence, decision state, or another
// team member's unread count.
model PortfolioIqOwnerWatchReview {
  id              String   @id @default(cuid())
  portfolioId     String
  organizationId  String
  userId          String
  objectType      String
  objectKey       String
  reviewedThrough DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, userId, objectType, objectKey])
  @@index([organizationId, userId, updatedAt(sort: Desc)])
  @@index([portfolioId, userId])
}

// The permanent first-period owner report. Before approval the route renders
// current activation evidence. Approval freezes the exact baseline used for
// the launch call so later monitoring can explain what changed from day one.
model PortfolioIqLaunchBriefing {
  id          String    @id @default(cuid())
  portfolioId String    @unique
  status      String    @default("draft") // draft | approved
  snapshot    String
  generatedAt DateTime  @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt(sort: Desc)])
}

// Immutable, dated evidence snapshots for the owner monitoring loop. The
// launch baseline and each weekly observation use the same versioned contract,
// so every reported change can be reproduced without altering source data.
model PortfolioIqMonitoringSnapshot {
  id                     String   @id @default(cuid())
  portfolioId            String
  periodKey              String
  snapshot               String
  sourceAvailableThrough String?
  capturedAt             DateTime @default(now())
  capturedBy             String?
  createdAt              DateTime @default(now())

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, periodKey])
  @@index([portfolioId, capturedAt(sort: Desc)])
}

// One idempotent monitoring result per portfolio and ISO week. Source health
// is recorded even when no alerts are created, so missing or unchanged inputs
// never masquerade as a quiet market.
model PortfolioIqMonitoringRun {
  id                     String    @id @default(cuid())
  portfolioId            String
  periodKey              String
  triggerKind            String    @default("scheduled")
  status                 String    @default("running") // running | completed | completed_with_errors | blocked
  sourceHealth           String    @default("unknown") // healthy | unchanged | unavailable
  sourceAvailableThrough String?
  materialChanges        Int       @default(0)
  alertsActivated        Int       @default(0)
  alertsResolved         Int       @default(0)
  error                  String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  portfolio PortfolioIqPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, periodKey])
  @@index([status, startedAt(sort: Desc)])
  @@index([portfolioId, startedAt(sort: Desc)])
}

// High-touch owner onboarding intake. The customer supplies only what they
// have; activation staff resolve identity, URUs, comps, and operator outreach
// in the existing Portfolio IQ activation console.
model PortfolioIqOnboardingRequest {
  id                     String    @id @default(cuid())
  organizationId         String
  portfolioId            String?
  status                 String    @default("started") // started | intake_received | call_requested | scheduled | activating | launch_ready | complete
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  preferredContactWindow String?
  timezone               String?
  intakeNotes            String?
  callRequestedAt        DateTime?
  scheduledFor           DateTime?
  intakeReceivedAt       DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  properties   PortfolioIqOnboardingProperty[]

  @@unique([organizationId])
  @@index([status, updatedAt(sort: Desc)])
  @@index([portfolioId])
}

model PortfolioIqOnboardingProperty {
  id                   String    @id @default(cuid())
  requestId            String
  propertyName         String?
  addressLine          String
  canonicalAddress     String?
  city                 String?
  state                String?
  postalCode           String?
  unitCount            Int?
  assetType            String?
  sourceKind           String    @default("manual") // manual | spreadsheet
  status               String    @default("received") // received | reviewed | needs_customer | activated
  promotionMode        String? // new_asset | existing_asset
  targetAssetId        String?
  activatedAssetId     String?
  dwellsyCommunityId   String?
  observedOperatorName String?
  matchConfidence      Float?
  reviewNote           String?
  reviewedAt           DateTime?
  reviewedBy           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  request        PortfolioIqOnboardingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  activatedAsset PortfolioIqAsset?            @relation(fields: [activatedAssetId], references: [id], onDelete: SetNull)

  @@unique([requestId, addressLine])
  @@index([requestId, status])
  @@index([activatedAssetId])
}

// One economic asset in an owner's portfolio. A multifamily community may
// contain several physical buildings, while a single-family home is an asset
// with one building. Dwellsy community and URU fields record real matching
// state; the pilot never invents an identifier when one is not known.
model PortfolioIqAsset {
  id                         String   @id @default(cuid())
  portfolioId                String
  slug                       String
  name                       String
  assetType                  String // multifamily | single_family
  suppliedAddress            String
  canonicalAddress           String?
  city                       String
  state                      String
  postalCode                 String
  unitCount                  Int?
  dwellsyCommunityId         String?
  matchStatus                String   @default("needs_review") // matched | needs_review | unmatched
  matchConfidence            Float?
  readinessStatus            String   @default("needs_confirmation")
  uruStatus                  String   @default("unknown") // observed | partial | needs_issuance | unknown
  compSetStatus              String   @default("not_started") // ready | review | not_started
  observedOperatorName       String?
  operatorRelationshipStatus String   @default("observed")
  sourceNote                 String?
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  portfolio            PortfolioIqPortfolio             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  buildings            PortfolioIqBuilding[]
  operatorAssignments  PortfolioIqOperatorAssignment[]
  activationTasks      PortfolioIqActivationTask[]
  compSet              PortfolioIqCompSet?
  signals              PortfolioIqSignal[]
  insightExposures     DwellsyIqInsightExposure[]
  onboardingProperties PortfolioIqOnboardingProperty[]
  pmBriefs             PortfolioIqPmBrief[]
  financialAssumptions PortfolioIqFinancialAssumption[]

  @@unique([portfolioId, slug])
  @@index([portfolioId, sortOrder])
  @@index([dwellsyCommunityId])
}

// Owner-controlled assumptions used only to translate asking-rent evidence
// into a prioritization range. Bedroom -1 is the property-wide assumption;
// nonnegative values represent product segments. These are never source data.
model PortfolioIqFinancialAssumption {
  id              String    @id @default(cuid())
  assetId         String
  bedrooms        Int       @default(-1)
  inventoryUnits  Int?
  affectedUnits   Int?
  realizationPct  Float     @default(0.5)
  conservativePct Float     @default(0.25)
  upsidePct       Float     @default(0.75)
  sourceKind      String    @default("owner_interview") // owner_interview | owner_file | pm_confirmed | system_default
  sourceLabel     String?
  effectiveAt     DateTime?
  reviewStatus    String    @default("draft") // draft | verified | needs_owner | needs_pm
  reviewedAt      DateTime?
  reviewedBy      String?
  note            String?
  updatedBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset PortfolioIqAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, bedrooms])
  @@index([assetId, updatedAt(sort: Desc)])
}

model PortfolioIqBuilding {
  id                 String   @id @default(cuid())
  assetId            String
  label              String?
  suppliedAddress    String
  canonicalAddress   String
  city               String
  state              String
  postalCode         String
  latitude           Float?
  longitude          Float?
  dwellsyCommunityId String?
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  asset PortfolioIqAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, canonicalAddress])
  @@index([assetId])
}

// Operator assignments are dated because a change in property manager is an
// owner signal. The canonical link is optional: an observed source name can be
// retained while the internal team resolves it to Operator IQ.
model PortfolioIqOperatorAssignment {
  id                   String    @id @default(cuid())
  assetId              String
  canonicalOperatorId  String?
  observedOperatorName String
  sourceKind           String    @default("dwellsy_observation")
  verificationStatus   String    @default("observed")
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  isCurrent            Boolean   @default(true)
  createdAt            DateTime  @default(now())

  asset             PortfolioIqAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  canonicalOperator CanonicalOperator? @relation(fields: [canonicalOperatorId], references: [id], onDelete: SetNull)

  @@index([assetId, isCurrent])
  @@index([canonicalOperatorId])
}

// Internal assisted-onboarding queue. The customer sees a simple readiness
// state; staff work these concrete tasks behind the scenes.
model PortfolioIqActivationTask {
  id           String    @id @default(cuid())
  assetId      String
  taskType     String // match_review | issue_uru | operator_outreach | comp_setup | customer_confirmation
  status       String    @default("open") // open | in_progress | blocked | complete
  assignedLane String    @default("activation_ops")
  note         String?
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  asset PortfolioIqAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, taskType])
  @@index([status, assignedLane])
  @@index([assetId])
}

// One current proposed or reviewed comp set per portfolio asset. Members are
// snapshots of asking listings from an immutable Market IQ source import, so
// an owner can see exactly what evidence supported a comparison at that time.
model PortfolioIqCompSet {
  id             String    @id @default(cuid())
  assetId        String    @unique
  name           String
  status         String    @default("proposed") // proposed | reviewed | locked
  methodology    String
  sourceImportId String
  generatedAt    DateTime  @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asset    PortfolioIqAsset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  members  PortfolioIqCompMember[]
  segments PortfolioIqCompSegment[]

  @@index([sourceImportId])
}

model PortfolioIqCompSegment {
  id         String    @id @default(cuid())
  compSetId  String
  bedrooms   Int
  status     String    @default("proposed") // proposed | locked
  reviewedAt DateTime?
  reviewedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  compSet PortfolioIqCompSet @relation(fields: [compSetId], references: [id], onDelete: Cascade)

  @@unique([compSetId, bedrooms])
  @@index([compSetId, status])
}

model PortfolioIqCompMember {
  id              String    @id @default(cuid())
  compSetId       String
  comparisonKey   String
  sourceRecordId  String
  propertyLabel   String
  address         String
  city            String?
  state           String?
  postalCode      String?
  propertyType    String
  bedrooms        Float?
  bathrooms       Float?
  askingRent      Float?
  squareFeet      Float?
  activatedAt     DateTime?
  selectionReason String
  reviewStatus    String    @default("proposed") // proposed | included | excluded
  exclusionReason String?
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())

  compSet PortfolioIqCompSet @relation(fields: [compSetId], references: [id], onDelete: Cascade)

  @@unique([compSetId, comparisonKey])
  @@index([compSetId])
  @@index([compSetId, reviewStatus])
  @@index([sourceRecordId])
}

// Ranked, evidence-gated owner signals. Fingerprints make refreshes
// idempotent and status preserves when an issue first appeared or resolved.
model PortfolioIqSignal {
  id            String    @id @default(cuid())
  portfolioId   String
  assetId       String?
  fingerprint   String    @unique
  signalType    String
  category      String // performance | market | readiness
  severity      String // high | medium | info
  confidence    String // high | medium | setup
  rankScore     Int
  headline      String
  narrative     String
  ownerQuestion String?
  evidence      String    @default("{}")
  status        String    @default("active") // active | resolved
  observedAt    DateTime
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  portfolio       PortfolioIqPortfolio         @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset           PortfolioIqAsset?            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  decision        PortfolioIqSignalDecision?
  unifiedInsight  DwellsyIqInsight?
  pmBriefs        PortfolioIqPmBrief[]
  findingFeedback PortfolioIqFindingFeedback[]

  @@index([portfolioId, status, rankScore(sort: Desc)])
  @@index([assetId, status])
  @@index([observedAt(sort: Desc)])
}

// A deliberately narrow collaboration artifact for one property and one
// evidence-backed issue. Publication freezes a PM-safe snapshot that excludes
// the owner's other assets and all Operator IQ rankings.
model PortfolioIqPmBrief {
  id                 String    @id @default(cuid())
  portfolioId        String
  assetId            String
  signalId           String
  publicToken        String    @unique
  status             String    @default("published") // published | responded | closed | revoked
  title              String
  snapshot           String
  ownerNote          String?
  responseDueAt      DateTime?
  recipientName      String?
  recipientEmail     String?
  deliveryStatus     String    @default("not_sent") // not_sent | sent | failed
  deliveryProviderId String?
  deliveryError      String?
  acceptedAt         DateTime?
  deliveredAt        DateTime?
  lastEmailEventAt   DateTime?
  lastEmailEventType String?
  lastReminderAt     DateTime?
  reminderCount      Int       @default(0)
  remindersEnabled   Boolean   @default(false)
  publishedBy        String
  publishedAt        DateTime  @default(now())
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  portfolio PortfolioIqPortfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     PortfolioIqAsset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  signal    PortfolioIqSignal           @relation(fields: [signalId], references: [id], onDelete: Cascade)
  response  PortfolioIqPmBriefResponse?

  @@index([portfolioId, status, publishedAt(sort: Desc)])
  @@index([assetId, publishedAt(sort: Desc)])
  @@index([signalId, status])
  @@index([deliveryStatus, responseDueAt])
}

model PortfolioIqPmBriefResponse {
  id               String    @id @default(cuid())
  briefId          String    @unique
  responderName    String
  responderEmail   String?
  assessment       String? // agree | partially_agree | disagree | need_more_information
  recommendation   String? // hold_pricing | raise_pricing | reduce_pricing | refresh_marketing | investigate | no_change | other
  responseSummary  String
  actionPlan       String?
  actionOwner      String?
  successMeasure   String?
  followUpDate     DateTime?
  ownerDisposition String    @default("pending") // pending | accepted | revised | closed
  ownerReviewNote  String?
  revisionCount    Int       @default(0)
  reviewedAt       DateTime?
  reviewedBy       String?
  submittedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())

  brief PortfolioIqPmBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([submittedAt(sort: Desc)])
  @@index([ownerDisposition, submittedAt(sort: Desc)])
}

// One customer-facing finding across the Dwellsy IQ Online decision system.
// Existing analytical engines remain authoritative, while this shared layer
// records how a finding connects market evidence, portfolio exposure, comps,
// and observed operator context for a specific owner organization.
model DwellsyIqInsight {
  id                String    @id @default(cuid())
  organizationId    String
  portfolioId       String
  sourceSignalId    String    @unique
  sourceAlertId     String?
  fingerprint       String    @unique
  insightType       String
  category          String
  severity          String
  confidence        String
  rankScore         Int
  headline          String
  narrative         String
  suggestedFollowup String?
  marketId          String
  geographyType     String?
  geographyValue    String?
  propertyType      String?
  bedrooms          Int?
  evidenceSources   String    @default("[]")
  status            String    @default("active")
  observedAt        DateTime
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio    PortfolioIqPortfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  sourceSignal PortfolioIqSignal          @relation(fields: [sourceSignalId], references: [id], onDelete: Cascade)
  exposures    DwellsyIqInsightExposure[]

  @@index([organizationId, status, rankScore(sort: Desc)])
  @@index([portfolioId, status, rankScore(sort: Desc)])
  @@index([marketId, geographyType, geographyValue, observedAt(sort: Desc)])
  @@index([sourceAlertId])
}

// An insight can affect several owner assets over time. The first Cleveland
// pilot creates one direct exposure per source signal, while the model already
// supports a single market event expanding to multiple properties and operators.
model DwellsyIqInsightExposure {
  id             String   @id @default(cuid())
  insightId      String
  assetId        String
  exposureKind   String   @default("direct")
  relevanceScore Int
  operatorName   String?
  evidence       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  insight DwellsyIqInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  asset   PortfolioIqAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([insightId, assetId])
  @@index([assetId, relevanceScore(sort: Desc)])
}

// The analytical signal remains immutable from the owner's perspective.
// Decision state is stored separately so acknowledging or resolving an item
// never rewrites the evidence that caused it to appear.
model PortfolioIqSignalDecision {
  id                   String    @id @default(cuid())
  signalId             String    @unique
  organizationId       String
  state                String    @default("open") // open | acknowledged | snoozed | resolved
  assignedTo           String?
  assignedUserId       String? // Clerk userId for an organization member; null for role or PM assignments
  note                 String?
  actionPlan           String?
  successMeasure       String?
  dueAt                DateTime?
  monitoringWindowDays Int?
  baselineEvidence     String?
  baselineCapturedAt   DateTime?
  snoozedUntil         DateTime?
  decidedBy            String
  decidedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  signal         PortfolioIqSignal                @relation(fields: [signalId], references: [id], onDelete: Cascade)
  events         PortfolioIqSignalDecisionEvent[]
  outcomeReviews PortfolioIqOutcomeReview[]

  @@index([organizationId, state, updatedAt(sort: Desc)])
  @@index([organizationId, assignedUserId, state])
}

// A dated, owner-reviewed comparison between the immutable decision baseline
// and later asking-market evidence. Source health is explicit so an unchanged
// or unavailable feed cannot be interpreted as a successful outcome.
model PortfolioIqOutcomeReview {
  id                     String    @id @default(cuid())
  portfolioId            String
  decisionId             String
  periodKey              String
  status                 String    @default("waiting_for_source") // waiting_for_source | ready | reviewed
  sourceHealth           String    @default("unchanged") // healthy | unchanged | unavailable
  sourceAvailableThrough String?
  comparison             String
  conclusion             String? // improved | unchanged | worsened | inconclusive
  implementationStatus   String? // completed | partially_completed | not_completed | unknown
  nextDecision           String? // continue | adjust | escalate | close
  reviewNote             String?
  nextReviewAt           DateTime?
  generatedAt            DateTime  @default(now())
  reviewedAt             DateTime?
  reviewedBy             String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  portfolio PortfolioIqPortfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  decision  PortfolioIqSignalDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([decisionId, periodKey])
  @@index([portfolioId, status, generatedAt(sort: Desc)])
  @@index([decisionId, generatedAt(sort: Desc)])
}

model PortfolioIqSignalDecisionEvent {
  id             String   @id @default(cuid())
  decisionId     String
  action         String
  fromState      String?
  toState        String
  assignedTo     String?
  assignedUserId String?
  note           String?
  actorUserId    String
  createdAt      DateTime @default(now())

  decision PortfolioIqSignalDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId, createdAt(sort: Desc)])
}

model PortfolioIqDigestPreference {
  id              String    @id @default(cuid())
  portfolioId     String
  organizationId  String
  userId          String
  enabled         Boolean   @default(false)
  cadence         String    @default("weekly")
  lastDeliveredAt DateTime?
  lastSignalAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  portfolio  PortfolioIqPortfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  deliveries PortfolioIqDigestDelivery[]

  @@unique([portfolioId, userId])
  @@index([organizationId, enabled])
}

model PortfolioIqDigestDelivery {
  id                  String    @id @default(cuid())
  preferenceId        String
  deliveryKey         String    @unique
  signalCutoff        DateTime
  email               String
  status              String
  triggerKind         String    @default("scheduled") // scheduled | preview
  briefingVersion     Int       @default(1)
  materialFingerprint String?
  snapshot            String?
  providerId          String?
  error               String?
  acceptedAt          DateTime?
  deliveredAt         DateTime?
  lastEmailEventAt    DateTime?
  lastEmailEventType  String?
  createdAt           DateTime  @default(now())

  preference PortfolioIqDigestPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, signalCutoff])
  @@index([status, createdAt(sort: Desc)])
  @@index([preferenceId, materialFingerprint])
}

// v0.22 — explicit per-market grants for an organization. One row per
// (org, market) the org has purchased. The effective entitlement is
// `org.allMarkets ? <all markets> : <set of these marketIds>`. Managed
// entirely from the admin panel (no Clerk involvement). marketId is the
// Market.id string ("chattanooga-tn"); not an FK so granting a market
// can't be blocked by Market-row lifecycle and a removed market simply
// stops resolving — but the @@unique keeps grants idempotent.
model OrganizationMarketAccess {
  id             String   @id @default(cuid())
  organizationId String
  marketId       String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, marketId])
  @@index([organizationId])
}

// v0.18 (PR #71, Phase 3) — Transient row marking a user as
// "should see the welcome toast next time they're active in this
// org." Written by the organizationInvitation.accepted webhook
// handler when an invitee accepts; checked + deleted inline on
// the next /watch-lists render when the user's active org matches.
//
// Design notes:
//   - One-shot semantics: present means "deliver welcome next time";
//     deleted on the first /watch-lists render that catches it.
//     The @@unique([userId, organizationId]) keeps the row idempotent
//     against duplicate webhook delivery (re-delivery is a no-op
//     upsert).
//   - Cascade-delete with Organization so removing an org cleans
//     up any orphaned pending welcomes. userId is a soft Clerk
//     reference (no FK), same convention as elsewhere in this
//     schema.
//   - Tiny table — typically empty between invitation acceptance
//     and the new user's next /watch-lists visit. No retention
//     concerns at v1 scale; if it ever grows, a cron job clearing
//     rows older than 30 days is the obvious sweep.
//
// Rationale for a dedicated table over Clerk publicMetadata: see
// PR #71's design decision section. tl;dr: avoids Clerk API rate
// limits on the write path, gives us atomic delete-on-render, and
// simplifies the cleanup story.
model PendingWelcome {
  id             String   @id @default(cuid())
  userId         String // Clerk userId, opaque (no FK to a User table)
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // One pending welcome per (user × org). Webhook upserts on this
  // key, /watch-lists deletes by it.
  @@unique([userId, organizationId])
  // Hot query path: "is there a pending welcome for user X in org Y"
  // covered by the unique constraint's implicit index.
  @@index([userId])
}

// v0.18 — Mirror of Clerk's OrganizationMembership resource. Each
// row links a Clerk userId (opaque string, no FK constraint —
// users are owned by Clerk) to an Organization + role. Kept in
// sync by the organizationMembership.{created,updated,deleted}
// webhook handlers.
//
// Role values mirror Clerk's defaults: 'org:admin' | 'org:member'.
// We store the full Clerk-prefixed string so future role types
// (custom permissions in Clerk) don't require a migration.
//
// clerkMembershipId is the @unique sync key for idempotent upserts.
// (userId, organizationId) is also @unique because Clerk enforces
// "one membership per (user, org)" — duplicate webhook deliveries
// can hit either key without creating duplicates.
model OrganizationMembership {
  id                String   @id @default(cuid())
  clerkMembershipId String   @unique
  organizationId    String
  userId            String // Clerk userId, opaque
  role              String // "org:admin" | "org:member"
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  // Hot query: "list all memberships for user X" (drives org
  // switcher in Phase 2 and getActiveOrgId fallback in Phase 1).
  @@index([userId])
  @@index([organizationId])
}

// v0.23 — Admin operator-merge tool. Human-curated decisions about
// within-market operator fragmentation (one operator recorded as several
// records). One row per (market, cluster) the admin has acted on:
//   decision "merge"   — collapse memberSlugs into survivorSlug under
//                        canonicalName (applied OFFLINE by the pipeline:
//                        pool raw listings + recompute metrics/stars).
//   decision "dismiss" — reviewed, not a merge; don't resurface.
// Nothing in the app mutates operator records at read time — this table
// only captures decisions; the pipeline is the single applier.
model OperatorMergeDecision {
  id              String   @id @default(cuid())
  marketId        String
  // Normalized-name identity of the cluster (lowercase, punctuation +
  // legal-suffix stripped). Stable key so a decided cluster stops
  // surfacing as a candidate.
  clusterKey      String
  decision        String // "merge" | "dismiss"
  canonicalName   String? // chosen display name (merge only)
  survivorSlug    String? // operator whose slug the merged group keeps (merge only)
  memberSlugs     String   @default("[]") // JSON array of member PM slugs
  decidedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([marketId, clusterKey])
  @@index([marketId])
}

// Admin-curated display-name corrections. Single source of truth for a
// renamed operator. Applied TWICE: live (the /admin/names server action
// patches the operator's DB rows on save) and durably (prisma/seed.ts
// re-applies every row in-memory before recreating PMs, since a reseed
// hard-deletes + recreates PM/CanonicalOperator from the JSON). This
// table is deliberately NOT in seed.ts's deleteMany set, so corrections
// survive reseeds — same trick as OperatorMergeDecision / AppSetting.
//   targetKind "pm"        — targetKey is a PM slug (one market).
//   targetKind "canonical" — targetKey is a canonicalSlug (the group).
/// Operator-reported unit counts — ground truth for calibrating the size
/// estimator, captured when an operator tells us their own number.
///
/// Deliberately INERT: nothing reads this to change a displayed figure, a size
/// band, a cohort, a rank, or a peer set. Three reasons. It is unverified
/// self-report, and operators have every reason to round up. Feeding it would
/// split the book into operators we have spoken to and everyone else, sized on
/// different bases, which quietly breaks every cohort comparison the product
/// rests on. And a number fed into the estimator can no longer validate it —
/// being ground truth IS the job.
///
/// Recalibration becomes arithmetic rather than archaeology at roughly fifteen
/// of these. Today there are three, and they live in a chat transcript.
model OperatorReportedSize {
  id              String   @id @default(cuid())
  /// "pm" (single-market slug) | "canonical" (the operating company).
  /// Canonical matters: a count like "950 units across four markets" belongs
  /// to the group, not to any one of its market rows.
  targetKind      String
  targetKey       String
  /// Total units the operator says they manage under this target.
  reportedUnits   Int
  /// When the OPERATOR said it — not when we typed it in. A count from a call
  /// six months ago is weaker evidence than today's, and the calibration has
  /// to be able to tell the difference.
  reportedAsOf    DateTime
  /// "ceo_call" | "operator_email" | "public_filing" | "website" | "other".
  /// Enumerated so sources can be weighted later (a filing outranks a phone
  /// call) without having to re-read every note to do it.
  sourceKind      String
  /// Free text for the context an enum can't hold — the actual quote, the
  /// caveat, who said it.
  sourceNote      String?
  decidedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([targetKind, targetKey])
}

model OperatorNameCorrection {
  id              String   @id @default(cuid())
  targetKind      String // "pm" | "canonical"
  targetKey       String // PM slug, or canonicalSlug/canonicalOperatorId
  correctedName   String
  originalName    String // name at first correction — powers Undo + staleness
  decidedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([targetKind, targetKey])
}

// v0.6.5 — generic key/value app settings, editable from the admin panel.
// First use: `sfr_turnover_multiplier` — the SFR portfolio-size multiplier
// applied to urusT12 (see src/lib/operator-size.ts). Values are stored as
// strings and parsed per `type`; consumers fall back to a hardcoded default
// when a key has no row yet, so the table can be empty on a fresh deploy
// without breaking reads (the row is created on first admin edit).
model AppSetting {
  key         String   @id
  value       String
  type        String   @default("string") // "string" | "number" | "boolean"
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// v0.24 — First-party, internal usage analytics. An append-only event
// log written SERVER-SIDE and fire-and-forget from key authenticated
// surfaces (logins, scorecard/operator/market/brief views, AI queries,
// watch-list activity). Read only from /admin/usage; never client-facing.
//
// This is an ADDITIVE parallel sink alongside PostHog (captureServerEvent)
// — it lets a Dwellsy admin answer "who logged in, per-client active
// users, which operators/markets get viewed" straight from our own Neon
// DB with no third-party dependency.
//
// PRIVACY: store Clerk IDs ONLY — never names or emails. Display names
// are resolved at READ TIME (userId → Clerk getUserList; orgId → the
// Organization mirror table). This keeps PII out of the event log, the
// same guardrail the PostHog sinks follow.
//
//   userId     — Clerk userId (opaque; no FK to a user table)
//   orgId      — Clerk org id (auth().orgId). Nullable: session.created
//                logins carry no org, and a session without an active
//                org resolves to null. Consistent source everywhere.
//   eventName  — "login" | "signup" | "scorecard_view" | "operator_view"
//                | "market_view" | "brief_view" | "ask_query"
//                | "watch_list_view" | "watch_list_create"
//   targetKind — "operator" | "market" | "brief" | "watch_list" (nullable)
//   targetSlug — pm slug / market id / etc (nullable)
//
// Indexed on the four columns every /admin/usage query filters or groups
// by (occurredAt for the time window, userId/orgId for rollups, eventName
// for per-event breakdowns).
model UsageEvent {
  id         String   @id @default(cuid())
  occurredAt DateTime @default(now())
  userId     String
  orgId      String?
  eventName  String
  targetKind String?
  targetSlug String?

  @@index([occurredAt])
  @@index([userId])
  @@index([orgId])
  @@index([eventName])
}

// v0.27 — Phase 2 individual-home detail. One row per distinct scattered-SFR
// home per operator, deduped on the source address id. Populated by the
// owner-run scripts/load-property-homes.ts from the pipeline's
// property_homes.jsonl extract (NOT reseeded with scorecardData). Read
// on-demand by the Properties export route to append a "Homes" sheet.
// Un-scored — observations only.
model PropertyHome {
  id             String    @id @default(cuid())
  pmSlug         String
  marketId       String
  addressId      String
  address        String
  submarket      String?
  latitude       Float?
  longitude      Float?
  bedrooms       Int?
  medianRentT12  Int?
  domT12         Int?
  lastListedDate DateTime?
  nListings      Int       @default(0)
  concession     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@unique([pmSlug, addressId])
  @@index([pmSlug])
}
